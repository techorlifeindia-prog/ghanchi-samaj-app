{
  "name": "ghanchi-samaj-app",
  "version": "1.0.0",
  "private": true,
  "description": "Shree Ghanchi Samaj - Family, Directory, Matrimonial & AI Community App",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "start": "tsx server/index.ts",
    "client:dev": "vite client --port 3007 --host",
    "server:dev": "tsx watch server/index.ts",
    "build": "vite build client && tsc --project server/tsconfig.json",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx server/migrate.ts",
    "deploy:vps": "node scripts/deploy-local.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@types/cors": "^2.8.19",
    "clsx": "^2.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.7",
    "express": "^4.19.2",
    "lucide-react": "^0.359.0",
    "pg": "^8.11.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.20.14",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.3",
    "vite": "^5.1.6"
  }
}
